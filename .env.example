# ── App settings ──────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Model settings ────────────────────────────────────────────
# Path to ONNX model (preferred for production CPU inference)
ONNX_MODEL_PATH=runs/detect/runs/train/yolo26n_pcb/weights/best.onnx
# Fallback PyTorch weights
PT_MODEL_PATH=runs/detect/runs/train/yolo26n_pcb/weights/best.pt
# Confidence threshold for detections
CONF_THRESHOLD=0.25
# IoU threshold for NMS
IOU_THRESHOLD=0.45
# Input image size (must match training imgsz)
IMGSZ=640

# ── Decision logic ────────────────────────────────────────────
# Comma-separated class names treated as critical (→ REJECT)
CRITICAL_CLASSES=OP,SH
# Min defects for REVIEW when no critical defect
REVIEW_MIN_DEFECTS=1

# ── Dataset ───────────────────────────────────────────────────
DATASET_URL=https://figshare.com/ndownloader/files/44069552
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
